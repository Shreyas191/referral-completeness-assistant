# Which LLM to use. Keep one provider and model for every system in an experiment.
#   anthropic: claude-haiku-5-5 (default, cheapest), claude-sonnet-5-5, claude-opus-5-5
#   openai:    gpt-6-luna (default, cheapest), gpt-6.1-sol, gpt-6-astra
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# USD per million tokens for LLM_MODEL (from the provider's pricing page), used for cost in metrics.json.
# Update both when you change the model; the prices used are saved with every run.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

CHROMA_DIR=data/chroma
RETRIEVAL_TOP_K=5

# Seconds before an LLM request is abandoned and retried, and how many retries before the run fails.
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
