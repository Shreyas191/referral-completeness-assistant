# Which LLM to use. Keep one provider and model for every system in an experiment.
#   anthropic: claude-haiku-5-5 (default, cheapest), claude-sonnet-5-5, claude-opus-5-5
#   openai:    gpt-6-luna (default, cheapest), gpt-6.1-sol, gpt-6-astra
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

CHROMA_DIR=data/chroma
RETRIEVAL_TOP_K=5
